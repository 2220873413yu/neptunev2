<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xms.dao.mapper.AccelerateReleaseConfigMapper">

    <resultMap type="AccelerateReleaseConfig" id="AccelerateReleaseConfigResult">
        <result property="id"    column="id"    />
        <result property="targetDays"    column="target_days"    />
        <result property="fuelToken"    column="fuel_token"    />
        <result property="fuelRatio"    column="fuel_ratio"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="deleted"    column="deleted"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
    </resultMap>

    <sql id="selectAccelerateReleaseConfigVo">
        select id, target_days, fuel_token, fuel_ratio, status, create_time, update_time, remark, deleted, create_by, update_by from t_accelerate_release_config
    </sql>

    <select id="selectAccelerateReleaseConfigList" parameterType="AccelerateReleaseConfig"
            resultMap="AccelerateReleaseConfigResult">
        <include refid="selectAccelerateReleaseConfigVo"/>
        <where>
            <if test="targetDays != null "> and target_days = #{targetDays}</if>
            <if test="fuelToken != null  and fuelToken != ''"> and fuel_token = #{fuelToken}</if>
            <if test="fuelRatio != null "> and fuel_ratio = #{fuelRatio}</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
        order by id desc
    </select>

</mapper>
