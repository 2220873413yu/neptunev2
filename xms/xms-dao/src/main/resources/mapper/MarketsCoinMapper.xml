<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xms.dao.mapper.MarketsCoinMapper">

    <resultMap type="MarketsCoin" id="MarketsCoinResult">
        <result property="id"    column="id"    />
        <result property="icon"    column="icon"    />
        <result property="symbol"    column="symbol"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectMarketsCoinVo">
        select id, icon, symbol, create_time, update_time from t_markets_coin
    </sql>

    <select id="selectMarketsCoinList" parameterType="MarketsCoin"
            resultMap="MarketsCoinResult">
        <include refid="selectMarketsCoinVo"/>
        <where>
            <if test="icon != null  and icon != ''"> and icon = #{icon}</if>
            <if test="symbol != null  and symbol != ''"> and symbol like concat('%', #{symbol}, '%')</if>
            <if test="createTime != null "> and create_time = #{createTime}</if>
        </where>
        order by id desc
    </select>

</mapper>
