<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xms.dao.mapper.UserLevelConfigMapper">

    <resultMap type="UserLevelConfig" id="UserLevelConfigResult">
        <result property="id"    column="id"    />
        <result property="level"    column="level"    />
        <result property="performance"    column="performance"    />
        <result property="umbrellaPerformance"    column="umbrella_performance"    />
        <result property="rewardRatio"    column="reward_ratio"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="deleted"    column="deleted"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="peerRewardRatio"    column="peer_reward_ratio"    />
        <result property="hasStudioSubsidy"    column="has_studio_subsidy"    />
        <result property="minBuyAmount"    column="min_buy_amount"    />
    </resultMap>

    <sql id="selectUserLevelConfigVo">
        select min_buy_amount, has_studio_subsidy, peer_reward_ratio, id, level, performance, umbrella_performance, reward_ratio, create_time, update_time, remark, deleted, create_by, update_by from t_user_level_config
    </sql>

    <select id="selectUserLevelConfigList" parameterType="UserLevelConfig"
            resultMap="UserLevelConfigResult">
        <include refid="selectUserLevelConfigVo"/>
        <where>
            <if test="level != null "> and level = #{level}</if>
            <if test="hasStudioSubsidy != null "> and has_studio_subsidy = #{hasStudioSubsidy}</if>
            <if test="performance != null "> and performance = #{performance}</if>
            <if test="umbrellaPerformance != null "> and umbrella_performance = #{umbrellaPerformance}</if>
            <if test="rewardRatio != null "> and reward_ratio = #{rewardRatio}</if>
        </where>
        order by level desc
    </select>

</mapper>
