<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xms.dao.mapper.HGiftReleaseBucketMapper">

    <resultMap type="HGiftReleaseBucket" id="HGiftReleaseBucketResult">
        <result property="id" column="id" />
        <result property="bucketNo" column="bucket_no" />
        <result property="userId" column="user_id" />
        <result property="account" column="account" />
        <result property="sourceType" column="source_type" />
        <result property="sourceOrderNo" column="source_order_no" />
        <result property="sourceUserId" column="source_user_id" />
        <result property="totalAmount" column="total_amount" />
        <result property="releasedAmount" column="released_amount" />
        <result property="remainingAmount" column="remaining_amount" />
        <result property="dailyReleaseAmount" column="daily_release_amount" />
        <result property="releaseDays" column="release_days" />
        <result property="releasedDays" column="released_days" />
        <result property="startDate" column="start_date" />
        <result property="lastReleaseDate" column="last_release_date" />
        <result property="status" column="status" />
        <result property="remark" column="remark" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="selectHGiftReleaseBucketVo">
        select id, bucket_no, user_id, account, source_type, source_order_no, source_user_id,
               total_amount, released_amount, remaining_amount, daily_release_amount,
               release_days, released_days, start_date, last_release_date,
               status, remark, create_time, update_time
        from t_h_gift_release_bucket
    </sql>

    <select id="selectHGiftReleaseBucketList" parameterType="HGiftReleaseBucket" resultMap="HGiftReleaseBucketResult">
        <include refid="selectHGiftReleaseBucketVo"/>
        <where>
            <if test="bucketNo != null and bucketNo != ''"> and bucket_no = #{bucketNo}</if>
            <if test="userId != null"> and user_id = #{userId}</if>
            <if test="account != null and account != ''"> and account = #{account}</if>
            <if test="sourceType != null"> and source_type = #{sourceType}</if>
            <if test="sourceOrderNo != null and sourceOrderNo != ''"> and source_order_no = #{sourceOrderNo}</if>
            <if test="status != null"> and status = #{status}</if>
            <if test="params.beginCreateTime != null and params.beginCreateTime != '' and params.endCreateTime != null and params.endCreateTime != ''">
                and create_time between #{params.beginCreateTime} and #{params.endCreateTime}
            </if>
        </where>
        order by id desc
    </select>

</mapper>
