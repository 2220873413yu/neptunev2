<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xms.dao.mapper.InterestStatDayMapper">

    <resultMap type="InterestStatDay" id="InterestStatDayResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="statDate"    column="stat_date"    />
        <result property="todayInterest"    column="today_interest"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectInterestStatDayVo">
        select id, user_id, order_no, stat_date, today_interest, create_time from xms_interest_stat_day
    </sql>

    <select id="selectInterestStatDayList" parameterType="InterestStatDay"
            resultMap="InterestStatDayResult">
        <include refid="selectInterestStatDayVo"/>
        <where>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="orderNo != null  and orderNo != ''"> and order_no = #{orderNo}</if>
            <if test="statDate != null "> and stat_date = #{statDate}</if>
            <if test="todayInterest != null "> and today_interest = #{todayInterest}</if>
            <if test="params.beginCreateTime != null and params.beginCreateTime != '' and params.endCreateTime != null and params.endCreateTime != ''"> and create_time between #{params.beginCreateTime} and #{params.endCreateTime}</if>
        </where>
        order by id desc
    </select>

    <select id="todayInterest" parameterType="long"  resultType="com.xms.dao.entity.dto.InterestStatDayDto">
        select id, today_interest as todayInterest, create_time as createTime
        from xms_interest_stat_day where user_id = #{userId}
        order by id desc
    </select>
</mapper>
