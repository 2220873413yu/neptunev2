<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xms.dao.mapper.AirdropRoundMapper">

    <resultMap type="AirdropRound" id="AirdropRoundResult">
        <result property="id"    column="id"    />
        <result property="roundNo"    column="round_no"    />
        <result property="status"    column="status"    />
        <result property="totalQuota"    column="total_quota"    />
        <result property="claimedQuota"    column="claimed_quota"    />
        <result property="lockedQuota"    column="locked_quota"    />
        <result property="tokenPerClaim"    column="token_per_claim"    />
        <result property="autoOpenNext"    column="auto_open_next"    />
        <result property="nextRoundNo"    column="next_round_no"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="sort"    column="sort"    />

        <result property="okbPayAmount"    column="okb_pay_amount"    />
    </resultMap>

    <sql id="selectAirdropRoundVo">
        select okb_pay_amount, id, round_no, status, total_quota, claimed_quota, locked_quota, token_per_claim, auto_open_next, next_round_no, remark, create_time, update_time, sort from t_airdrop_round
    </sql>

    <select id="selectAirdropRoundList" parameterType="AirdropRound"
            resultMap="AirdropRoundResult">
        <include refid="selectAirdropRoundVo"/>
        <where>
            <if test="roundNo != null "> and round_no = #{roundNo}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="totalQuota != null "> and total_quota = #{totalQuota}</if>
            <if test="claimedQuota != null "> and claimed_quota = #{claimedQuota}</if>
            <if test="lockedQuota != null "> and locked_quota = #{lockedQuota}</if>
            <if test="tokenPerClaim != null "> and token_per_claim = #{tokenPerClaim}</if>
            <if test="autoOpenNext != null "> and auto_open_next = #{autoOpenNext}</if>
            <if test="nextRoundNo != null "> and next_round_no = #{nextRoundNo}</if>
            <if test="sort != null "> and sort = #{sort}</if>
        </where>
        order by id desc
    </select>

</mapper>
