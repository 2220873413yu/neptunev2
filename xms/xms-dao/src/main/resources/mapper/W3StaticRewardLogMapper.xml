<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xms.dao.mapper.W3StaticRewardLogMapper">

    <resultMap type="W3StaticRewardLog" id="W3StaticRewardLogResult">
        <result property="id"    column="id"    />
        <result property="level"    column="level"    />
        <result property="levelRatio"    column="level_ratio"    />
        <result property="staticReward"    column="static_reward"    />
        <result property="rewardAmount"    column="reward_amount"    />
        <result property="userCount"    column="user_count"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="orderNo"    column="order_no"    />
    </resultMap>

    <sql id="selectW3StaticRewardLogVo">
        select id, level, level_ratio, static_reward, reward_amount, user_count, create_time, update_time, remark, order_no from t_w3_static_reward_log
    </sql>

    <select id="selectW3StaticRewardLogList" parameterType="W3StaticRewardLog"
            resultMap="W3StaticRewardLogResult">
        <include refid="selectW3StaticRewardLogVo"/>
        <where>
            <if test="level != null "> and level = #{level}</if>
            <if test="levelRatio != null "> and level_ratio = #{levelRatio}</if>
            <if test="staticReward != null "> and static_reward = #{staticReward}</if>
            <if test="rewardAmount != null "> and reward_amount = #{rewardAmount}</if>
            <if test="userCount != null "> and user_count = #{userCount}</if>
            <if test="params.beginCreateTime != null and params.beginCreateTime != '' and params.endCreateTime != null and params.endCreateTime != ''"> and create_time between #{params.beginCreateTime} and #{params.endCreateTime}</if>
            <if test="orderNo != null  and orderNo != ''"> and order_no = #{orderNo}</if>
        </where>
        order by id desc
    </select>

</mapper>
