<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xms.dao.mapper.BuyHOrderMapper">

    <resultMap type="BuyHOrder" id="BuyHOrderResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="walletAddress"    column="wallet_address"    />
        <result property="payHAmount"    column="pay_h_amount"    />
        <result property="pointsAmount"    column="points_amount"    />
        <result property="payHash"    column="pay_hash"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="status"    column="status"    />
        <result property="stakeRoundId"    column="stake_round_id"    />
    </resultMap>

    <sql id="selectBuyHOrderVo">
        select stake_round_id, status, id, user_id, order_no, wallet_address, pay_h_amount, points_amount, pay_hash, remark, create_time, update_time from t_buy_h_order
    </sql>

    <select id="selectBuyHOrderList" parameterType="BuyHOrder"
            resultMap="BuyHOrderResult">
        <include refid="selectBuyHOrderVo"/>
        <where>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="stakeRoundId != null "> and stake_round_id = #{stakeRoundId}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="orderNo != null  and orderNo != ''"> and order_no = #{orderNo}</if>
            <if test="walletAddress != null  and walletAddress != ''"> and wallet_address = #{walletAddress}</if>
            <if test="payHAmount != null "> and pay_h_amount = #{payHAmount}</if>
            <if test="pointsAmount != null "> and points_amount = #{pointsAmount}</if>
            <if test="payHash != null  and payHash != ''"> and pay_hash = #{payHash}</if>
            <if test="params.beginCreateTime != null and params.beginCreateTime != '' and params.endCreateTime != null and params.endCreateTime != ''"> and create_time between #{params.beginCreateTime} and #{params.endCreateTime}</if>
        </where>
        order by id desc
    </select>

</mapper>
