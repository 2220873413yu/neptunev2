<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xms.dao.mapper.StakeRoundMapper">

    <resultMap type="StakeRound" id="StakeRoundResult">
        <result property="id"    column="id"    />
        <result property="status"    column="status"    />
        <result property="bizStatus"    column="biz_status"    />
        <result property="liquidationCheckEnabled"    column="liquidation_check_enabled"    />
        <result property="startTime"    column="start_time"    />
        <result property="liquidationTime"    column="liquidation_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="playerStakeTotal"    column="player_stake_total"    />
        <result property="studioSubsidyTotal"    column="studio_subsidy_total"    />
        <result property="withdrawRewardTotalFull"    column="withdraw_reward_total_full"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="insuranceBalance"    column="insurance_balance"    />
        <result property="buyPointTotal"    column="buy_point_total"    />
    </resultMap>

    <sql id="selectStakeRoundVo">
        select buy_point_total, biz_status, liquidation_check_enabled, insurance_balance, id, status, start_time, liquidation_time, end_time, player_stake_total, studio_subsidy_total, withdraw_reward_total_full, remark, create_time, update_time from t_stake_round
    </sql>

    <select id="selectStakeRoundList" parameterType="StakeRound"
            resultMap="StakeRoundResult">
        <include refid="selectStakeRoundVo"/>
        <where>
            <if test="id != null "> and id = #{id}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="bizStatus != null "> and biz_status = #{bizStatus}</if>
            <if test="liquidationCheckEnabled != null "> and liquidation_check_enabled = #{liquidationCheckEnabled}</if>
            <if test="startTime != null "> and start_time = #{startTime}</if>
            <if test="liquidationTime != null "> and liquidation_time = #{liquidationTime}</if>
            <if test="endTime != null "> and end_time = #{endTime}</if>
            <if test="playerStakeTotal != null "> and player_stake_total = #{playerStakeTotal}</if>
            <if test="studioSubsidyTotal != null "> and studio_subsidy_total = #{studioSubsidyTotal}</if>
            <if test="withdrawRewardTotalFull != null "> and withdraw_reward_total_full = #{withdrawRewardTotalFull}</if>
            <if test="params.beginCreateTime != null and params.beginCreateTime != '' and params.endCreateTime != null and params.endCreateTime != ''"> and create_time between #{params.beginCreateTime} and #{params.endCreateTime}</if>
        </where>
        order by id desc
    </select>

</mapper>
